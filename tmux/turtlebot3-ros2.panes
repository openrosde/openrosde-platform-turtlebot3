# Panes of the Robotis TurtleBot3 platform on ROS 2 for 'RUN-TMUX-SESSION.bash', in the window 'robot' of the session.
# Each line reads '<layouts> <window> <launch-file> [<arg:=value> ...]', where '<layouts>' is '*' or a comma-separated list such as 'default-gazebo,default-realworld'.
# The panes of the core on ROS 2, such as the rqt suite and 'rosbridge', come from 'tmux/openrosde-ros2.panes' of the core.

default-gazebo     robot  turtlebot3_bringup_default_gazebo.launch.py
default-gazebo     robot  turtlebot3_rviz_default_gazebo.launch.xml
default-gazebo     robot  turtlebot3_navigation_default_gazebo.launch.xml
default-gazebo     robot  turtlebot3_mapping_default.launch.xml use_sim_time:=true

default-realworld  robot  turtlebot3_rviz_default_realworld.launch.xml
default-realworld  robot  turtlebot3_mapping_default.launch.xml
