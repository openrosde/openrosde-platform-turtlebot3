<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openrosde_turtlebot3_launch</name>
  <version>1.0.0</version>
  <description>
    The 'openrosde_turtlebot3_launch' package provides launch files for the Robotis TurtleBot3 platform on ROS 2.
  </description>
  <maintainer email="lotfi@coarobo.com">Lotfi El Hafi</maintainer>

  <license>Apache-2.0</license>

  <url type="website">https://coarobo.com/</url>
  <url type="repository">https://gitlab.com/coarobo/openrosde/openrosde-platform-turtlebot3</url>
  <url type="bugtracker">https://gitlab.com/coarobo/openrosde/openrosde-platform-turtlebot3/-/issues</url>
  <author email="lotfi@coarobo.com">Lotfi El Hafi</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>openrosde_launch</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_navigation2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
